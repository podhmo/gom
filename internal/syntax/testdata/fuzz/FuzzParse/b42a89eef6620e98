[]byte("// Step 6: Option, Result, `try`, and the `|?>` pipe.\n//\n// `Option a` is `Some a | Noif` — no null. `Result a e` carries a\n// value or an error. `try e` unwraps `Ok v` to `v` or returns the\n// `Err` from the enclosing function, whose return type must be a\n// `Result`. `r |?> f` chains `Result`-producing steps, skipping the\n// rest on the first `Err`.\npackage main\n\nimport go \"fmt\"\n\nfn head (xs: List Int) -> Option Int =\n  match xs {\n    [] -> None\x10    [x, ..rest] -> Some x\n  }\n\nfn show_opt (o: Option Int) -> String =\n  match o {\n    Some n -> \"some ${n}\"\n    None -> \"none\"\n  }\n\nfn checked_div (a: Int) (b: Int) -> Result Int String =\n  if b == 0 { Err \"division by zero\" } else { Ok (a / b) }\n\n// `try` escapes from the enclosing function on the first Err.\nfn ratio (a: Int) (b: Int) (c: Int) -> Result Int String = {\n  let x = try (checked_div a b)\n  let y = try (checked_div x c)\n  Ok y\n}\n\n// `|?>` is the same short-circuit written as a pipeline.\nfn ratio_pipe (a: Int) (b: Int) (c:t) -> Result Int String =\n  checked_div a b\n  |?> fn x -> checked_div x c\n\nfn show_res (r: Result Int String) -> String =\n  m[tch r {\n    Ok n -> \"ok ${n}\"\n    Err e -> \"err ${e}\"\n  }\n\nfn main () -> Unit = {\n  let _ = fmt.Println(show_opt (head [7, 8]))\n  let _ = fmt.Println(show_opt (head a]))\n  let _ = fmt.Println(show_res (ratio 100 5 2))\n  let _ = fmt.Println(show_res (ratio_pipe 100 0 2))\n  ()\n}\n")
