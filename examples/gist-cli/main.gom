// A complete CLI: application decisions stay in Gom; host bridges Go I/O.
package main

import go "encoding/json"
import go "errors"
import go "fmt"
import go "github.com/podhmo/gom/examples/gist-cli/host"
import go "io"
import go "net/http"
import go "os"
import go "path"
import go "path/filepath"
import go "regexp"
import go "strings"
import go "unicode/utf8"

type Files =
  | NoFiles
  | File String Files

type Config = { api: String, gist: String, files: Files, literal: Bool, help: Bool }

fn text_error (r: Result a GoError) -> Result a String = match r {
  Ok value -> Ok value
  Err e -> Err (e.Error ())
}

// Decodes one JSON object and extracts a nonempty string field,
// rejecting trailing JSON data, missing fields, non-string values,
// and empty strings (what host.StringField did before the move).
fn string_field (document: String) (key: String) -> Result String GoError = {
  let object : Ptr (Go.Map String json.RawMessage) = Ptr.new ()
  let dec = json.NewDecoder (strings.NewReader document)
  try dec.Decode object
  let extra : Ptr Go.Any = Ptr.new ()
  match dec.Decode extra {
    Err e -> if errors.Is (e, io.EOF) { () } else { try Err e }
    Ok _ -> try Err (fmt.Errorf "response has trailing JSON data")
  }
  let raw = try (match Go.Map.get (Ptr.get object) key {
    Some r -> Ok r
    None -> Err (fmt.Errorf ("response has no %s field", key))
  })
  let bytes : Go.Slice Byte = Go.conv raw : Go.Slice Byte
  let value : Ptr String = Ptr.new ()
  match json.Unmarshal (bytes, value) {
    Err e -> try Err (fmt.Errorf ("response %s must be a string: %v", key, e))
    Ok _ -> ()
  }
  let v = Ptr.get value
  if v == "" { Err (fmt.Errorf ("response %s is empty", key)) } else { Ok v }
}

fn usage () -> String = "usage: gist-cli [--api-url URL] [--gist URL] [--] FILE..."

// `os.Args` is a `Go.Slice String`; element 0 is the executable
// name, so the user-visible argument count excludes it and
// `arg_at` reads one ahead.
fn arg_count () -> Int = Go.Slice.length os.Args - 1

fn arg_at (index: Int) -> String = Option.get (Go.Slice.get (os.Args, index + 1))

fn parse_args (index: Int) (cfg: Config) -> Result Config String = if index == arg_count () {
  Ok cfg
} else {
  let arg = arg_at index
  if cfg.literal { parse_args (index + 1) { cfg with files = File arg cfg.files } } else {
    match arg {
      "--help" -> Ok { cfg with help = true }
      "--" -> parse_args (index + 1) { cfg with literal = true }
      "--gist" -> if index + 1 == arg_count () { Err "--gist requires a URL" } else {
        if cfg.gist != "" { Err "--gist may only be supplied once" } else {
          let url = arg_at (index + 1)
          if url == "" { Err "--gist requires a URL" } else {
            parse_args (index + 2) { cfg with gist = url }
          }
        }
      }
      "--api-url" -> if index + 1 == arg_count () { Err "--api-url requires a URL" } else {
        parse_args (index + 2) { cfg with api = arg_at (index + 1) }
      }
      _ -> if strings.HasPrefix (arg, "-") { Err "unknown option: ${arg}" } else {
        parse_args (index + 1) { cfg with files = File arg cfg.files }
      }
    }
  }
}

fn contains (xs: Files) (value: String) -> Bool = match xs {
  NoFiles -> false
  File x rest -> if x == value { true } else { contains rest value }
}

fn read_text (path: String) -> Result String GoError = {
  let data = try os.ReadFile path
  if utf8.Valid data { Ok (Go.conv data : String) } else {
    Err (fmt.Errorf ("%s: file is not UTF-8 text", path))
  }
}

// `json.Marshal` cannot fail on a String.
fn quote (value: String) -> String = match json.Marshal value {
  Ok raw -> Go.conv raw : String
  Err _ -> todo ()
}

fn file_entries (paths: Files) (seen: Files) (entries: String) (separator: String) -> Result String String = match paths {
  NoFiles -> Ok entries
  File file rest -> {
    let name = filepath.Base file
    if contains seen name { Err "duplicate filename: ${name}" } else {
      let content = try text_error (read_text file)
      let entry = fmt.Sprintf ("%s:{\"content\":%s}", quote name, quote content)
      file_entries rest (File name seen) (fmt.Sprintf ("%s%s%s", entries, separator, entry)) ","
    }
  }
}

fn valid_gist_url (url: String) -> Bool = match regexp.MatchString (
  "^https://gist\\.github\\.com/([A-Za-z0-9-]+/)?[0-9a-fA-F]+/?$",
  url,
) {
  Ok matches -> matches
  Err _ -> false
}

fn run (cfg: Config) -> Result String String = {
  if cfg.files == NoFiles { Err (usage ()) } else {
    if cfg.gist != "" && not (valid_gist_url cfg.gist) { Err "invalid Gist URL: ${cfg.gist}" } else {
      let endpoint_ok =
        try text_error (regexp.MatchString ("^https?://[^/?#]+(/[^?#]*)?$", cfg.api))
      if not endpoint_ok { Err "invalid API URL: ${cfg.api}" } else {
        let token = os.Getenv "GITHUB_TOKEN"
        if token == "" { Err "GITHUB_TOKEN is required" } else {
          let entries = try file_entries cfg.files NoFiles "" ""
          let creating = cfg.gist == ""
          let method = if creating { "POST" } else { "PATCH" }
          let route = if creating { "/gists" } else {
            fmt.Sprintf ("/gists/%s", path.Base cfg.gist)
          }
          let visibility = if creating { ",\"public\":false" } else { "" }
          let body = fmt.Sprintf ("{\"files\":{%s}%s}", entries, visibility)
          let url = fmt.Sprintf ("%s%s", strings.TrimRight (cfg.api, "/"), route)
          let request = try text_error (http.NewRequest (method, url, strings.NewReader body))
          let headers = request.Header
          headers.Set ("Accept", "application/vnd.github+json")
          headers.Set ("Content-Type", "application/json")
          headers.Set ("Authorization", fmt.Sprintf ("Bearer %s", token))
          headers.Set ("X-GitHub-Api-Version", "2026-03-10")
          let client = host.NewClient (Go.func2 (fn _req _via -> Err http.ErrUseLastResponse))
          let response = try text_error (client.Do request)
          let status = response.StatusCode
          let response_body = try text_error (read_response response)
          let expected = if creating { 201 } else { 200 }
          if status != expected { Err "HTTP ${status}: ${response_body}" } else {
            let result_url = try text_error (string_field response_body "html_url")
            if valid_gist_url result_url { Ok result_url } else {
              Err "response html_url is not a Gist URL"
            }
          }
        }
      }
    }
  }
}

// Bounded response read: 2 MiB limit, Body closed on every path
// (no defer — the close is explicit before the `try` propagates).
fn read_response (response: Ptr http.Response) -> Result String GoError = {
  let read = io.ReadAll (io.LimitReader (response.Body, 2097153))
  ignore response.Body.Close ()
  let data = try read
  if List.length data > 2097152 { Err (fmt.Errorf ("response exceeds %d bytes", 2097152)) } else {
    Ok (Go.conv data : String)
  }
}

fn fail (message: String) -> Unit = {
  ignore fmt.Fprintln (os.Stderr, fmt.Sprintf ("gist-cli: %s", message))
  ignore os.Exit 1
  ()
}

fn main () -> Unit = {
  let initial: Config = {
    api = "https://api.github.com",
    gist = "",
    files = NoFiles,
    literal = false,
    help = false,
  }
  match parse_args 0 initial {
    Err message -> fail message
    Ok cfg -> if cfg.help { ignore fmt.Println (usage ()) } else {
      match run cfg {
        Ok url -> ignore fmt.Println url
        Err message -> fail message
      }
    }
  }
}
