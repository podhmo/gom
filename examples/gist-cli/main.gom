// A complete CLI written in Gom: argument grammar, Gist request
// building, local file reads, and HTTP — no host package.
package main

import go "fmt"
import go "os"

fn main () -> Unit = match parse_args (program_args ()) {
  Ok (Help) -> ignore fmt.Println usage
  Ok (Upload opts) -> match run opts {
    Ok url -> ignore fmt.Println url
    Err message -> fail message
  }
  Err message -> fail message
}

fn run (opts: Options) -> Result String String = {
  let token = os.Getenv "GITHUB_TOKEN"
  try require (token != "") "GITHUB_TOKEN is required"
  let files = try load_files opts.files
  let request = try text_error (gist_request opts.api token opts.target files)
  let response = try text_error (perform request)
  gist_html_url opts.target response
}

fn text_error (r: Result a GoError) -> Result a String = match r {
  Ok value -> Ok value
  Err e -> Err (e.Error ())
}

fn fail (message: String) -> Unit = {
  ignore fmt.Fprintln (os.Stderr, fmt.Sprintf ("gist-cli: %s", message))
  ignore os.Exit 1
  ()
}
