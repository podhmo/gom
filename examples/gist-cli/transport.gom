package main

import go "fmt"
import go "io"
import go "net/http"
import go "strings"
import go "time"

// Generic HTTP: nothing here knows about Gists.
type HttpRequest = { method: String, url: String, headers: List (String, String), body: String }

type HttpResponse = { status: Int, body: String }

// 30-second timeout; redirects are reported, never followed.
let client: Ptr http.Client = {
  let c: Ptr http.Client = Ptr.new ()
  c.Timeout = 30 * time.Second
  c.CheckRedirect = Go.func2 (fn _req _via -> Err http.ErrUseLastResponse)
  c
}

fn perform (req: HttpRequest) -> Result HttpResponse GoError = {
  let request = try http.NewRequest (req.method, req.url, strings.NewReader req.body)
  for (name, value) in req.headers { request.Header.Set (name, value) }
  let response = try client.Do request
  let body = try read_body response
  Ok { status = response.StatusCode, body = body }
}

// Bounded response read: 2 MiB limit, Body closed on every path
// (no defer — the close is explicit before the `try` propagates).
fn read_body (response: Ptr http.Response) -> Result String GoError = {
  let read = io.ReadAll (io.LimitReader (response.Body, 2097153))
  ignore response.Body.Close ()
  let data = try read
  if List.length data > 2097152 { Err (fmt.Errorf ("response exceeds %d bytes", 2097152)) } else {
    Ok (Go.conv data : String)
  }
}
