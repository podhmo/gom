// Step 13: `for` loops and guaranteed tail calls.
//
// `for pat in xs { ... }` is a Unit-valued loop: `xs` can be a
// `List`, a `View` (an O(1) read-only slice of a list), a
// `Go.Slice`, or a channel (step 18). The pattern destructures
// tuples and records like `let` and `match` patterns do. There is
// no `break`/`continue` — recursion is the real loop. A self call
// in tail position is guaranteed to lower to a Go `for` loop, and
// `@tailrec` makes the compiler prove it (spec 1.1).
package main

import go "fmt"

@tailrec
fn fold_sum (acc: Int) (xs: List Int) -> Int = match xs {
  [] -> acc
  [x, ..rest] -> fold_sum (acc + x) rest
}

fn main () -> Unit = {
  for x in [1, 2, 3] { ignore (fmt.Println "n ${x}") }
  // Patterns destructure each element — here a list of pairs.
  for (k, v) in [("a", 1), ("b", 2)] {
    ignore (fmt.Println "${k}=${v}")
  }
  // `List.slice xs lo hi` is an O(1) `View` sharing the backing.
  for x in List.slice [9, 8, 7, 6] 1 3 {
    ignore (fmt.Println "view ${x}")
  }
  // A `View` is a value too: pass it around without copying.
  let v = List.view [5, 6]
  ignore (fmt.Println "len ${View.length v}, last ${Option.get (View.get v 1)}")
  ignore (fmt.Println "sum ${fold_sum 0 [1, 2, 3, 4]}")
  ()
}
