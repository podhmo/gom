// Step 2: values, let bindings, and if-expressions.
//
// Every Gom program is built from expressions: `if` is an expression
// (so it needs `else` unless the then-branch is `Unit`), and a `{ }`
// block's value is its last expression. `"${x}"` is string
// interpolation.
package main

import go "fmt"

fn classify (n: Int) -> String = if n > 40 { "big" } else { "small" }

fn main () -> Unit = {
  let answer = 6 * 7
  let ratio = 3.0 / 2.0
  ignore (fmt.Println "${answer} is ${classify answer}")
  ignore (fmt.Println "1 is ${classify 1}")
  ignore (fmt.Println "ratio: ${ratio}")
  ignore (fmt.Println "bool: ${answer == 42 && 1 < 2}")
  ()
}
