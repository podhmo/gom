// Step 9: putting it together — a tiny port parser.
//
// Everything so far, in one program: a Go call whose `(T, error)`
// becomes `Result Int GoError`, a conversion into our own error
// type, a `|?>` chain with a validation step, and a match on the
// final Result.
package main

import go "fmt"
import go "strconv"

fn to_s (r: Result Int GoError) -> Result Int String = match r {
  Ok n -> Ok n
  Err _ -> Err "not a number"
}

fn parse_port (s: String) -> Result Int String =
  to_s (strconv.Atoi s) |?> fn p -> if p > 0 && p < 65536 { Ok p } else { Err "out of range" }

fn describe (r: Result Int String) -> String = match r {
  Ok p -> "listening on port ${p}"
  Err e -> "bad port: ${e}"
}

fn main () -> Unit = {
  ignore (fmt.Println (describe (parse_port "8080")))
  ignore (fmt.Println (describe (parse_port "abc")))
  ignore (fmt.Println (describe (parse_port "70000")))
  ()
}
