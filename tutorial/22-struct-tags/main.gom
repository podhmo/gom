// Step 22: Go struct tags on record fields.
//
// A record field may carry a Go struct tag as a verbatim raw
// string after its type — `{ name: String `json:"name"` }`. The
// field still emits as PascalCase on the Go struct, so the tag is
// what reflection-based packages (encoding/json and friends) see.
// A tag that is not `key:"value"` shaped is rejected (E0515).
//
// (spec 3.2; decision 2026-11-24-record-field-struct-tag)
package main

import go "fmt"
import go "encoding/json"

type User = { name: String `json:"user_name"`, age: Int `json:"age"` }

fn main () -> Unit = {
  // Marshal: the JSON object uses the tag names, not `Name`/`Age`.
  let u = { name = "pod", age = 40 }
  match json.Marshal u {
    Ok bs -> ignore (fmt.Println (Go.conv bs : String))
    Err e -> ignore (fmt.Println e)
  }
  // Unmarshal into a `Ptr` — Go's json wants a pointer, and a
  // `Ptr User` is exactly `*User` on the Go side (step 19).
  // `user_name` does not match `Name` case-insensitively, so the
  // decode only binds because of the tag.
  let data: Go.Slice Byte = Go.conv "{\"user_name\":\"mog\",\"age\":3}" : Go.Slice Byte
  let p: Ptr User = Ptr.new ()
  match json.Unmarshal data p {
    Ok _ -> {
      let got = Ptr.get p
      ignore (fmt.Println "${got.name} is ${got.age}")
    }
    Err e -> ignore (fmt.Println e)
  }
  ()
}
