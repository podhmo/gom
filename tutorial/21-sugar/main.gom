// Step 21: small syntax sugar — `type alias`, record spread,
// labeled lambdas.
//
// `type alias Meters = Int` is the real alias — plain
// `type Meters = Int` declares a *variant* named `Int`, a known
// grammar trap (docs/problems/2026-11-02-type-alias-body.md).
// `f ~..opts` spreads a record's fields into labeled parameters by
// name (spec 2). Lambdas take labels too: `fn ~x -> body` pairs
// with the call site's `~name:` pun (spec 1.2, decision
// 2026-11-23-labeled-arg-relaxation).
package main

import go "fmt"

type alias Meters = Int

type Opts = { dx: Int, dy: Int }

fn move (x: Int) (~dx: Int) (~dy: Int) -> (Int, Int) = (x + dx, x + dy)

fn main () -> Unit = {
  // Every field must match a `~label` parameter — `~..opts` is
  // `~dx: opts.dx ~dy: opts.dy`.
  let opts = { dx = 1, dy = 2 }
  let (a, b) = move 10 ~..opts
  ignore (fmt.Println "moved ${a},${b}")
  // Labeled lambda: `fn ~name -> ...` calls as `~name: v`.
  let greet = fn ~name -> "hi ${name}"
  ignore (fmt.Println (greet ~name: "gom"))
  // An alias is transparent — `Meters` *is* `Int`.
  let d: Meters = 5
  ignore (fmt.Println "meters ${d + 1}")
  ()
}
