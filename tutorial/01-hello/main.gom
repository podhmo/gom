// Step 1: the smallest runnable Gom program.
//
// `package main` + `fn main () -> Unit` becomes Go's `func main()`.
// `import go "fmt"` imports the real Go package — no declarations
// needed. `fmt.Println` returns `(int, error)` in Go, which Gom sees
// as `Result Int GoError`; a block demands `Unit` in the middle, so
// the call is discarded with `ignore e` (spec 1.1).
package main

import go "fmt"

fn main () -> Unit = { ignore fmt.Println "hello, gom"; () }
