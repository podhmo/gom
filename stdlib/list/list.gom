package list

/// List is the builtin immutable list; these are the operations the
/// `List` module publishes (stdlib/list/list.gomi).
///
/// Conventions: the list being worked on is the LAST parameter so
/// `xs |> List.map f` pipelines read naturally; functions that can
/// miss return `Option` instead of panicking.
fn of (x: a) -> List a = [x]

fn cons (x: a) (xs: List a) -> List a = [x, ..xs]

/// append xs ys is xs ++ ys. Buffer-built Go impl (impl.go) —
/// the cons-per-step shape is O(n²) on the slice List repr.
@extern
fn append (xs: List a) (ys: List a) -> List a

/// rev_append xs onto = rev xs ++ onto, in one pass.
@tailrec
fn rev_append (xs: List a) (onto: List a) -> List a = match xs {
  [] -> onto
  [x, ..rest] -> rev_append rest [x, ..onto]
}

/// rev xs is xs reversed. Buffer-built Go impl (impl.go).
@extern
fn rev (xs: List a) -> List a

fn is_empty (xs: List a) -> Bool = match xs {
  [] -> true
  _ -> false
}

fn length (xs: List a) -> Int = length_go 0 xs

fn head (xs: List a) -> Option a = match xs {
  [] -> None
  [x, ..rest] -> Some x
}

fn tail (xs: List a) -> Option (List a) = match xs {
  [] -> None
  [x, ..rest] -> Some rest
}

@tailrec
fn get (n: Int) (xs: List a) -> Option a = match xs {
  [] -> None
  [x, ..rest] -> if n == 0 { Some x } else { get (n - 1) rest }
}

/// take n xs is the first n elements of xs — all of xs when
/// n >= length xs, [] when n <= 0. Buffer-built Go impl (impl.go).
@extern
fn take (n: Int) (xs: List a) -> List a

/// drop n xs is xs without its first n elements — [] when n >=
/// length xs, xs itself when n <= 0. Shares the tail's backing.
@tailrec
fn drop (n: Int) (xs: List a) -> List a = match xs {
  [] -> []
  [_, ..rest] -> if n <= 0 { xs } else { drop (n - 1) rest }
}

/// last xs is the final element of xs, if any.
@tailrec
fn last (xs: List a) -> Option a = match xs {
  [] -> None
  [x] -> Some x
  [_, ..rest] -> last rest
}

/// last_n n xs is the final n elements of xs — all of xs when
/// n >= length xs, [] when n <= 0.
fn last_n (n: Int) (xs: List a) -> List a = drop (length xs - n) xs

/// map f xs applies f to every element in order. Buffer-built
/// Go impl (impl.go).
@extern
fn map (f: a -> b) (xs: List a) -> List b

/// filter f xs keeps the elements that satisfy f, in order.
/// Buffer-built Go impl (impl.go).
@extern
fn filter (f: a -> Bool) (xs: List a) -> List a

/// fold f acc xs is the left fold f(...f(f(acc, x0), x1)..., xn).
@tailrec
fn fold (f: b -> a -> b) (acc: b) (xs: List a) -> b = match xs {
  [] -> acc
  [x, ..rest] -> fold f (f acc x) rest
}

fn iter (f: a -> Unit) (xs: List a) -> Unit = for x in xs { ignore f x }

@tailrec
fn find (f: a -> Bool) (xs: List a) -> Option a = match xs {
  [] -> None
  [x, ..rest] -> if f x { Some x } else { find f rest }
}

/// filter_map f xs keeps the payloads f returns as Some, in order —
/// map+filter fused, one pass. Buffer-built Go impl (impl.go).
@extern
fn filter_map (f: a -> Option b) (xs: List a) -> List b

/// find_map f xs returns the first Some payload f produces,
/// or None when f yields None for every element. Go impl (impl.go).
@extern
fn find_map (f: a -> Option b) (xs: List a) -> Option b

/// concat xss = xss[0] ++ xss[1] ++ ... — `List.join` in OCaml.
/// Buffer-built Go impl (impl.go) — one pass over the total size;
/// the right-fold shape stacked a frame per sublist (O(k) depth).
@extern
fn concat (xss: List (List a)) -> List a

/// sort_by lt xs is xs sorted ascending under lt — a fresh list.
/// slices.SortFunc-backed Go impl (impl.go), O(n log n). `Cmp.sort`
/// packages the same shape behind an `Ord` dictionary.
///
/// lt must be a strict weak order — plain `<` is NOT one for
/// floats: lt(NaN, x) and lt(x, NaN) are both false, which reports
/// every NaN equal to everything. Use `Cmp.float_ord`'s `lt`
/// (NaN-aware total order) when sorting Float lists.
@extern
fn sort_by (lt: a -> a -> Bool) (xs: List a) -> List a

/// sum xs adds the elements of a Float list left to right.
/// A dedicated loop: folding a curried `f acc x` would allocate one
/// closure per element (the arity-one value repr — P5-3).
fn sum (xs: List Float) -> Float = sum_go 0.0 xs

/// sum_int xs adds the elements of an Int list left to right —
/// the Int counterpart of `sum` (Gom has no overloading, so the
/// element type is part of the name).
fn sum_int (xs: List Int) -> Int = sumi_go 0 xs

/// range lo hi is [lo, lo+1, ..., hi-1]; empty when lo >= hi.
/// Buffer-built Go impl (impl.go).
@extern
fn range (lo: Int) (hi: Int) -> List Int

// --- private helpers ---
@tailrec
fn length_go (acc: Int) (xs: List a) -> Int = match xs {
  [] -> acc
  [_, ..rest] -> length_go (acc + 1) rest
}

@tailrec
fn sum_go (acc: Float) (xs: List Float) -> Float = match xs {
  [] -> acc
  [x, ..rest] -> sum_go (acc + x) rest
}

@tailrec
fn sumi_go (acc: Int) (xs: List Int) -> Int = match xs {
  [] -> acc
  [x, ..rest] -> sumi_go (acc + x) rest
}

test "of/cons build literals" { assert_eq (of 1) [1]; assert_eq (cons 1 [2, 3]) [1, 2, 3] }

test "append and rev" {
  assert_eq (append [1, 2] [3]) [1, 2, 3]
  assert_eq (rev [1, 2, 3]) [3, 2, 1]
  assert_eq (rev_append [2, 1] [3]) [1, 2, 3]
}

test "length and is_empty" {
  let empty: List Int = []
  assert_eq (length [1, 2, 3]) 3
  assert (is_empty empty)
  assert (not (is_empty [1]))
}

test "head/tail/get return Option" {
  let empty: List Int = []
  assert_eq (head [1, 2]) (Some 1)
  assert_eq (head empty) None
  assert_eq (tail [1, 2]) (Some [2])
  assert_eq (tail empty) None
  assert_eq (get 1 [10, 20, 30]) (Some 20)
  assert_eq (get 9 [10]) None
  assert_eq (get (-1) [10, 20]) None
  assert_eq (get 3 [10, 20, 30]) None
}

test "map/filter/fold" {
  assert_eq (map (fn x -> x + 1) [1, 2]) [2, 3]
  assert_eq (filter (fn x -> x > 1) [1, 2, 3]) [2, 3]
  assert_eq (fold (fn a x -> a + x) 0 [1, 2, 3]) 6
}

test "sum" { assert_eq (sum [1.5, 2.5]) 4.0 }

test "range" { assert_eq (range 0 4) [0, 1, 2, 3]; assert_eq (range 3 3) [] }

test "array builder round trip" {
  let a = Array.make 3 0
  for i in range 0 3 { Array.set a i (i * 10) }
  assert_eq (Array.to_list a) [0, 10, 20]
  assert_eq (Array.length a) 3
  assert_eq (Array.get a 1) 10
  let b = Array.from_list [1, 2]
  Array.set b 0 9
  assert_eq (Array.to_list b) [9, 2]
}

test "take/drop/last/last_n" {
  assert_eq (take 2 [1, 2, 3]) [1, 2]
  assert_eq (take 9 [1, 2]) [1, 2]
  assert_eq (take 0 [1, 2]) []
  assert_eq (drop 1 [1, 2, 3]) [2, 3]
  assert_eq (drop 9 [1, 2]) []
  assert_eq (drop 0 [1, 2]) [1, 2]
  assert_eq (last [1, 2, 3]) (Some 3)
  let empty: List Int = []
  assert_eq (last empty) None
  assert_eq (last_n 2 [1, 2, 3]) [2, 3]
  assert_eq (last_n 9 [1, 2]) [1, 2]
  assert_eq (last_n 0 [1, 2]) []
}

test "sort_by and sum_int" {
  assert_eq (sort_by (fn x y -> x < y) [3, 1, 2]) [1, 2, 3]
  assert_eq (sort_by (fn x y -> x > y) [3, 1, 2]) [3, 2, 1]
  assert_eq (sort_by (fn x y -> x < y) ["b", "a"]) ["a", "b"]
  assert_eq (sum_int [1, 2, 3]) 6
  let empty: List Int = []
  assert_eq (sum_int empty) 0
}

test "concat and find" {
  assert_eq (concat [[1], [2, 3]]) [1, 2, 3]
  assert_eq (find (fn x -> x > 1) [1, 2, 3]) (Some 2)
  assert_eq (find (fn x -> x > 9) [1, 2]) None
}

test "filter_map and find_map" {
  let parse = fn x -> if x > 0 { Some (x * 10) } else { None }
  assert_eq (filter_map parse [1, -2, 3]) [10, 30]
  assert_eq (filter_map parse [-1, -2]) []
  assert_eq (find_map parse [-1, 2, 3]) (Some 20)
  assert_eq (find_map parse [-1, -2]) None
}
