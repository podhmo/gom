package cmp

/// Comparison dictionaries — the explicit-dictionary idiom the
/// ad-hoc-polymorphism decision picks over type classes
/// (docs/decisions/2026-11-19-ad-hoc-poly-dict-passing.md). A
/// dictionary is an ordinary record passed as the FIRST argument;
/// callers name the instance (`int_ord`, `desc int_ord`).
///
/// `Eq a` carries `eq`, `Ord a` carries `lt`. The records stay
/// minimal — everything else (`member`, `min`, `sort`) derives from
/// the one operation.
///
/// `Eq a` is a dictionary of equality operations over a.
type Eq a = { eq : a -> a -> Bool }

/// Ord a is a dictionary of ordering operations over a — `lt x y`
/// reports whether x comes before y.
type Ord a = { lt : a -> a -> Bool }

let int_eq : Eq Int

let int_ord : Ord Int

let float_eq : Eq Float

/// float_ord is a TOTAL order: NaN sorts before every finite value
/// (a != a marks a NaN; b == b a non-NaN). Raw `<` alone would make
/// lt(NaN, x) and lt(x, NaN) both false — then `eq_of float_ord`
/// calls NaN equal to everything and SortBy loses strict weak order.
let float_ord : Ord Float

let string_eq : Eq String

let string_ord : Ord String

let bool_eq : Eq Bool

let byte_eq : Eq Byte

let char_eq : Eq Char

let char_ord : Ord Char

/// desc ord flips the ordering — `desc int_ord` sorts descending.
fn desc (ord: Ord a) -> Ord a

/// eq_of ord derives the equality an ordering induces:
/// x == y iff neither is less than the other.
fn eq_of (ord: Ord a) -> Eq a

/// member e x xs reports whether some element of xs equals x
/// under the dictionary e.
fn member (e: Eq a) (x: a) (xs: List a) -> Bool

/// min ord xs is the least element under ord, or None on [].
//gom:result-notaint min 0
fn min (ord: Ord a) (xs: List a) -> Option a

/// max ord xs is the greatest element under ord, or None on [].
//gom:result-notaint max 0
fn max (ord: Ord a) (xs: List a) -> Option a

//gom:noescape fold_min 0
fn fold_min (lt: a -> a -> Bool) (best: a) (xs: List a) -> a

//gom:noescape fold_max 0
fn fold_max (lt: a -> a -> Bool) (best: a) (xs: List a) -> a

/// option_eq e lifts equality onto Option: None equals None,
/// `Some x` equals `Some y` iff the payloads equal.
fn option_eq (e: Eq a) -> Eq (Option a)

/// option_ord o lifts ordering onto Option: None precedes every
/// Some, Somes compare by payload.
fn option_ord (o: Ord a) -> Ord (Option a)

/// list_eq e lifts equality onto List — same length, elementwise.
//gom:result-notaint list_eq 0
fn list_eq (e: Eq a) -> Eq (List a)

//gom:noescape list_eq_loop 0
fn list_eq_loop (eq: a -> a -> Bool) (xs: List a) (ys: List a) -> Bool

/// list_ord o lifts ordering onto List — lexicographic: shorter is
/// smaller on a shared prefix.
//gom:result-notaint list_ord 0
fn list_ord (o: Ord a) -> Ord (List a)

//gom:noescape list_lt_loop 0
fn list_lt_loop (lt: a -> a -> Bool) (xs: List a) (ys: List a) -> Bool

/// pair_eq ea eb lifts equality onto pairs — both halves equal.
fn pair_eq (ea: Eq a) (eb: Eq b) -> Eq (a, b)

/// pair_ord oa ob lifts ordering onto pairs — lexicographic on the
/// first component, then the second.
fn pair_ord (oa: Ord a) (ob: Ord b) -> Ord (a, b)

/// result_eq ea ee lifts equality onto Result — Ok pairs by payload,
/// Err pairs by payload, Ok never equals Err.
fn result_eq (ea: Eq a) (ee: Eq e) -> Eq (Result a e)

/// result_ord oa oe lifts ordering onto Result — every Ok precedes
/// every Err; same constructors compare by payload.
fn result_ord (oa: Ord a) (oe: Ord e) -> Ord (Result a e)

/// sort ord xs is xs sorted ascending under ord — a fresh list.
//gom:result-notaint sort 0
fn sort (ord: Ord a) (xs: List a) -> List a

/// sort_by lt xs is the comparator form sort lowers onto — a
/// slices.SortFunc-backed Go impl (impl.go), so the ordering is
/// O(n log n), not insertion sort.
fn sort_by (lt: a -> a -> Bool) (xs: List a) -> List a
