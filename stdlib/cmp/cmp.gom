package cmp

/// Comparison dictionaries — the explicit-dictionary idiom the
/// ad-hoc-polymorphism decision picks over type classes
/// (docs/decisions/2026-11-19-ad-hoc-poly-dict-passing.md). A
/// dictionary is an ordinary record passed as the FIRST argument;
/// callers name the instance (`int_ord`, `desc int_ord`).
///
/// `Eq a` carries `eq`, `Ord a` carries `lt`. The records stay
/// minimal — everything else (`member`, `min`, `sort`) derives from
/// the one operation.
///
/// `Eq a` is a dictionary of equality operations over a.
type Eq a = { eq: a -> a -> Bool }

/// Ord a is a dictionary of ordering operations over a — `lt x y`
/// reports whether x comes before y.
type Ord a = { lt: a -> a -> Bool }

let int_eq : Eq Int = { eq = fn a b -> a == b }
let int_ord : Ord Int = { lt = fn a b -> a < b }
let float_eq : Eq Float = { eq = fn a b -> a == b }
let float_ord : Ord Float = { lt = fn a b -> a < b }
let string_eq : Eq String = { eq = fn a b -> a == b }
let string_ord : Ord String = { lt = fn a b -> a < b }
let bool_eq : Eq Bool = { eq = fn a b -> a == b }
let byte_eq : Eq Byte = { eq = fn a b -> a == b }
let char_eq : Eq Char = { eq = fn a b -> a == b }
let char_ord : Ord Char = { lt = fn a b -> a < b }

/// desc ord flips the ordering — `desc int_ord` sorts descending.
fn desc (ord: Ord a) -> Ord a = { lt = fn x y -> ord.lt y x }

/// eq_of ord derives the equality an ordering induces:
/// x == y iff neither is less than the other.
fn eq_of (ord: Ord a) -> Eq a =
  { eq = fn x y -> not (ord.lt x y) && not (ord.lt y x) }

/// member e x xs reports whether some element of xs equals x
/// under the dictionary e.
fn member (e: Eq a) (x: a) (xs: List a) -> Bool = match xs {
  [] -> false
  [y, ..rest] -> if e.eq x y { true } else { member e x rest }
}

/// min ord xs is the least element under ord, or None on [].
fn min (ord: Ord a) (xs: List a) -> Option a = match xs {
  [] -> None
  [x, ..rest] -> Some (fold_min ord.lt x rest)
}

/// max ord xs is the greatest element under ord, or None on [].
fn max (ord: Ord a) (xs: List a) -> Option a = match xs {
  [] -> None
  [x, ..rest] -> Some (fold_max ord.lt x rest)
}

@tailrec
fn fold_min (lt: a -> a -> Bool) (best: a) (xs: List a) -> a = match xs {
  [] -> best
  [x, ..rest] -> fold_min lt (if lt x best { x } else { best }) rest
}

@tailrec
fn fold_max (lt: a -> a -> Bool) (best: a) (xs: List a) -> a = match xs {
  [] -> best
  [x, ..rest] -> fold_max lt (if lt best x { x } else { best }) rest
}

/// sort ord xs is xs sorted ascending under ord — a fresh list.
fn sort (ord: Ord a) (xs: List a) -> List a = sort_by ord.lt xs

/// sort_by lt xs is the comparator form sort lowers onto — a
/// slices.SortFunc-backed Go impl (impl.go), so the ordering is
/// O(n log n), not insertion sort.
@extern
fn sort_by (lt: a -> a -> Bool) (xs: List a) -> List a

test "member / eq_of" {
  assert (member int_eq 2 [1, 2, 3])
  assert (member string_eq "b" ["a", "b"])
  assert (not (member int_eq 9 [1, 2, 3]))
  let eqi : Eq Int = eq_of int_ord
  assert (member eqi 5 [5])
}

test "min / max / sort" {
  assert_eq (min int_ord [3, 1, 2]) (Some 1)
  assert_eq (max int_ord [3, 1, 2]) (Some 3)
  assert_eq (min int_ord []) None
  assert_eq (max (desc int_ord) [3, 1, 2]) (Some 1)
  assert_eq (sort int_ord [3, 1, 2]) [1, 2, 3]
  assert_eq (sort (desc int_ord) [3, 1, 2]) [3, 2, 1]
  assert_eq (sort string_ord ["b", "a"]) ["a", "b"]
}
