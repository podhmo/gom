package methodres

import go "io"
import go "io/fs"
import go "encoding"
import go "net/http"

type Sink = { n: Int }
type Bare = { v: Int }
type Failure = { reason: String }
type Dir = { ok: Bool }
type Hij = { live: Bool }

fn writer_of (s: Sink) -> io.Writer
fn unmarshaler_of (b: Bare) -> encoding.TextUnmarshaler
fn fs_of (d: Dir) -> fs.ReadDirFS
fn hijacker_of (h: Hij) -> http.Hijacker
