package geom

import go "fmt"
import go "os"
import go "time"

/// A planar shape — the ADT surfaces in Go as a sealed interface
/// plus per-variant structs (spec 8.7).
type Shape =
  | Circle (radius: Float)
  | Rect (w: Float) (h: Float)

fn area (s: Shape) -> Float

fn describe (s: Shape) -> String

fn nanos (d: time.Duration) -> Int

fn duration (n: Int) -> time.Duration

fn nameOf (s: fmt.Stringer) -> String

fn fileName (f: Ptr os.File) -> String

fn keepSlice (xs: Go.Slice Int) -> Go.Slice Int

fn freeze (xs: Go.Slice Int) -> List Int

fn thaw (xs: List Int) -> Go.Slice Int

fn total (xs: List Int) -> Int

fn isEmpty (xs: List Int) -> Bool

fn typeOfLit () -> String

fn typeOfVar (n: Int) -> String

fn typeOfSum (x: Int) (y: Int) -> String

fn kindOfLit () -> String

fn headOr (xs: List Int) -> Result Int String

fn isOk (r: Result Int String) -> Bool

fn headOpt (xs: List Int) -> Option Int
