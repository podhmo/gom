package ex

import go "os"
import go "time"
import go "sort"
import go "encoding/json"
import go "github.com/podhmo/gom/testdata/goiface"

// `Go.conv e : T` emits the conversion the pair names (spec 8.4):
// numeric and named-type pairs are `T(x)`, while `Go.Slice T ↔
// List T` is the boundary copy — `list.FromSlice` / `.ToSlice()` —
// the same conversions the implicit conformance emits (spec 8.5).
fn duration (n: Int) -> time.Duration = Go.conv n : time.Duration

fn nanos (d: time.Duration) -> Int = Go.conv d : Int

fn freeze (xs: Go.Slice Int) -> List Int = Go.conv xs : List Int

fn thaw (xs: List Int) -> Go.Slice Int = Go.conv xs : Go.Slice Int

fn runes (s: String) -> List Char = Go.conv s : List Char

fn args () -> List String = Go.conv os.Args : List String

// A named Go slice type (`type B []T` — sort.Float64Slice) converts
// through the boundary copy then casts: `B(xs.ToSlice())` /
// `list.FromSlice([]T(b))`. A named non-slice type keeps the raw
// `T(x)` — `json.Token` is `type Token any`, and boxing the List
// itself preserves its list.List[T] dynamic type for assertions.
fn to_named (xs: List Float) -> sort.Float64Slice = Go.conv xs : sort.Float64Slice

fn from_named (xs: sort.Float64Slice) -> List Float = Go.conv xs : List Float

fn to_token (xs: List Float) -> json.Token = Go.conv xs : json.Token

// The named-array split: a plain `[N]T` value keeps the raw `A(xs)`
// — the cast itself copies the array-length prefix — while a named
// pointer to an array still routes through the copy-then-cast
// composite, so the pointer shares the fresh ToSlice copy, never the
// List's backing.
fn to_arr (xs: List Int) -> goiface.Int64Arr = Go.conv xs : goiface.Int64Arr

fn to_arrp (xs: List Int) -> goiface.Int64ArrPtr = Go.conv xs : goiface.Int64ArrPtr

// A one-field record is the Go defined type `type X F` — the conv
// pairs emit `F(x)` / `X(f)` like any other `T(x)`. A `Ptr`-backed
// field renders `(*T)(x)` — bare `*T(x)` would parse as a
// dereference.
type UserId = { value : Int }
type P = { p : Ptr Int }

fn unwrap (u: UserId) -> Int = Go.conv u : Int

fn wrap (n: Int) -> UserId = Go.conv n : UserId

fn widen (u: UserId) -> Int64 = Go.conv u : Int64

fn derefT (p: P) -> Ptr Int = Go.conv p : Ptr Int

fn refT (p: Ptr Int) -> P = Go.conv p : P
