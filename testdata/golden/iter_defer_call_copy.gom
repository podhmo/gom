package ex

import go "github.com/podhmo/gom/testdata/goiface"

// A deferred call result pinned to `Go.Slice` by a later argument:
// the record's `iter` returns `List`, `f 0` resolves as the
// pending apply's claimed result, `Sum64` pins `Go.Slice`, and the
// committed `List` earns a boundary copy (`ToSlice`) at the
// argument instead of a failed rebind.
type IterBox = {iter: Int -> List Int}

fn via_call_result () -> Int = {
  let g = fn x -> {
    let f = x.iter
    let y = f 0
    goiface.Sum64 y
  }
  g ({iter = fn n -> [1, 2]})
}
