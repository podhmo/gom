package ex

import go "time"

// Named Go integer arithmetic (decision 2026-11-17-named-int-arith):
// the untyped literal conforms to the operand's named type, so
// `30 * time.Second` emits Duration arithmetic directly.
fn half_min () -> time.Duration = 30 * time.Second

fn add (a: time.Duration) (b: time.Duration) -> time.Duration = a + b

fn left (deadline: time.Duration) (now: time.Duration) -> time.Duration = deadline - now

fn maior (a: time.Duration) (b: time.Duration) -> Bool = a > b
