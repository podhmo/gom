package main

import go "github.com/podhmo/gom/testdata/goiface"

fn add (a: Int) (b: Int) -> Int = a + b

// `Go.func2` over a named curried fn — the literal's parameters
// and calls are fixed in the raw view.
fn apply_add () -> Int = goiface.Apply2 (Go.func2 add)

// An inline lambda's unannotated parameter takes the expected
// FuncN's Gom view — `x` binds `Go.Any`.
fn pick_any () -> Int = goiface.TakesAnyFn (Go.func1 (fn x -> 7))

// `Result Unit GoError` reads back as `error`.
fn check_give (n: Int) -> Result Unit GoError =
  goiface.Check (Go.func1 goiface.FailOnce)

// `Result T GoError` reads back as `(T, error)` — the error arm
// returns a fresh zero of the payload's raw type.
fn lookup_give () -> Result String GoError =
  goiface.LookAll (Go.func1 goiface.Give)

// A FuncN value is a value — stored, passed on, applied nowhere
// else in the language. `Go.FuncN` in an annotation pins the
// conversion's produced type.
let addf : Go.Func2 Int Int Int = Go.func2 add

// A func-typed parameter nests: `func(func(int64)) int64` is
// `Go.Func1 (Go.Func1 Int) Int`.
fn take_pair () -> Int = goiface.TakeFuncPair (Go.func1 (fn cb -> 9))

// `Go.func0` adapts a niladic thunk — `() -> Int` is
// `func() int64`.
fn apply_zero () -> Int = goiface.Apply0 (Go.func0 (fn () -> 41))

// An imported zero-parameter function adapts too — the adapter's
// call is `goiface.Tick()`, not `goiface.Tick` or a `struct{}` arg.
fn tick () -> Int = goiface.Apply0 (Go.func0 goiface.Tick)

// An extern declaration spelling the bare `error` result — the
// call itself returns `error`, so the adapter returns it directly
// rather than unwrapping a `Result` it does not have.
extern go "github.com/podhmo/gom/testdata/goiface" {
  fn FailOnce (x: Int) -> GoError
}
fn check_direct () -> Result Unit GoError =
  goiface.Check (Go.func1 goiface.FailOnce)

// A callback made inside a tail-recursive function captures its
// function parameter — the loop's snapshot binding keeps the
// current iteration's value.
fn drive (f: Int -> Int) (n: Int) -> Int = {
  let cb = Go.func1 f
  if n <= 0 { goiface.Apply1 cb } else { drive f (n - 1) }
}

// A `Result Unit GoError` source unwraps inside the adapter —
// `check_give` is a Gom function returning `Result`, so its
// adapter calls `Unwrap`.
let chk_wrapped : Go.Func1 Int GoError = Go.func1 check_give

// An imported `func(struct{}) int64` reads `Unit -> Int` too, but
// the adapter's call still passes the unit value.
fn via_u () -> Int = goiface.Apply0 (Go.func0 goiface.U)
