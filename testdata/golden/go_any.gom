package main

import go "encoding/json"
import go "strings"

// spec section 8.3: `Go.Any` materializes the box — a value
// conforming to a scalar `any` slot emits `any(x)` (a numeric
// through its Gom representation first, `int64(...)`), and inside a
// composite the `any` element *selects* the instantiation:
// `Option Go.Any` builds `Option[any]`, `Some 7` boxes its payload
// into the element slot (Go generics are invariant). A declared
// `-> Go.Any` result boxes the body's natural type at the boundary.
let x : Go.Any = 42
let s : Go.Any = "text"
let n : Option Go.Any = None
let o : Option Go.Any = Some 7
let r : Result Go.Any GoError = Ok 3
let l : List Go.Any = [1, 2]

fn id (a: Go.Any) -> Go.Any = a
fn box () -> Go.Any = "s"
fn boxok () -> Result Go.Any GoError = Ok 9

fn tok () -> Result Go.Any GoError = {
  let dec = json.NewDecoder(strings.NewReader("{}"))
  let t = try dec.Token()
  Ok t
}

fn takes (xs: List Go.Any) -> Unit = ignore xs

// The residual-boundary pins (wave 14): a lambda body under an
// expected `Int -> Go.Any` conforms to `any` at the body boundary;
// `==` boxes the concrete operand when the other side is `any`;
// a literal arm over an `any` subject materializes the literal's
// rep (`case int64(42)`, not Go's untyped `int`); and a `List`
// piped into a `Go.Slice` parameter takes the same `.ToSlice()`
// copy the direct application applies.
let g : Int -> Go.Any = fn x -> 1
fn feq (a: Go.Any) -> Bool = a == 42
fn m42 (a: Go.Any) -> String = match a { 42 -> "forty"; _ -> "other" }
fn mSome (o: Option Go.Any) -> String = match o { Some 42 -> "forty"; _ -> "other" }
fn take (l: Go.Slice String) -> Int = Go.Slice.length l

fn main () -> Unit = {
  takes [5]
  ignore (id x)
  ignore (box ())
  ignore (boxok ())
  ignore (tok ())
  ignore (g 0)
  ignore (feq x)
  ignore (m42 s)
  ignore (mSome o)
  ignore (["a", "b"] |> take)
}
