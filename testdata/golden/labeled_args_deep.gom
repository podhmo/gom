package main

import go "fmt"

fn inner (~b: Int) -> Int = b * 100

// `same` returns a labeled function: a `~b:` argument reaches past
// `same`'s own declared level into `inner`'s parameter.
fn same (~a: Int) -> ~b: Int -> Int = inner

fn weigh (~a: Int) (~b: Int) (~c: Int) -> Int = a + b * 10 + c * 100

// `third`'s declared level is two parameters; `~c` lives in the
// returned function's level.
fn third (~a: Int) (~b: Int) -> ~c: Int -> Int = weigh ~a: a ~b: b

fn main () -> Unit = {
  // A cross-level reorder compiles to a saturated call plus a
  // chained application — `same(1)(3)`, not `same(3)(1)`.
  ignore (fmt.Println "${same ~b: 3 ~a: 1}")
  // A deep fill leaving an earlier slot open is a partial
  // application — a Closure binding the remaining flat positions.
  let deep = same ~b: 3
  ignore (fmt.Println "${deep ~a: 2}")
  // A function *value* takes the same cross-level labels.
  let g = same
  ignore (fmt.Println "${g ~b: 4 ~a: 1}")
  // Deeper still: `~c` fills level 2 while `~a`/`~b` stay open.
  let skip = third ~c: 7
  ignore (fmt.Println "${skip ~b: 2 ~a: 1}")
  // Saturated in one call — prefix fill chaining onto the
  // returned function.
  ignore (fmt.Println "${third ~a: 1 ~c: 7 ~b: 2}")
  ()
}
