package main

import go "encoding/json"
import go "fmt"

// Record fields emit their verbatim Go struct tags so encoding/json
// honours them.
type User = { name: String `json:"name"`, mail: String `json:"mail,omitempty"` }

fn main () -> Unit = {
  let u = { name = "a", mail = "" }
  let b = match json.Marshal u { Ok v -> v; Err e -> [] }
  ignore (fmt.Println "${u} ${b}")
  ()
}
