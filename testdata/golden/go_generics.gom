package ex

import go "github.com/podhmo/gom/testdata/goiface"

// Generic Go calls instantiate by declared type-parameter order:
// `Second`'s emitted `Second[int64, string]` follows (A, B), not the
// first-occurrence (B, A). The `List` argument to `Count` copies out
// (`.ToSlice()`) before the call.
fn ident (n: Int) -> Int = goiface.Identity n
fn swap (s: String) (n: Int) -> Int = goiface.Second s n
fn count (xs: List String) (s: String) -> Int = goiface.Count xs s
fn lookup_or (m: Go.Map String Int) (k: String) -> Int = {
  let (v, ok) = goiface.Lookup m k
  if ok { v } else { 0 }
}

// A structural ~[]E constraint instantiates S to the argument's
// own repr — `List Int` emits `Index[list.List[int64], int64]`
// and the argument crosses without a copy (the constraint, not a
// []E parameter, is what the raw signature sees).
fn index (xs: List Int) (n: Int) -> Int = goiface.Index xs n

// A one-field record emits as the defined type `type UserId int64`,
// whose underlying admits the `~int64` term — `Clamp64[UserId]`
// instantiates verbatim (exact terms would not).
type UserId = { value : Int }
fn clamp_id (u: UserId) (lo: UserId) (hi: UserId) -> UserId = goiface.Clamp64 u lo hi
