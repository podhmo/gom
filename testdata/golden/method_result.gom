package main

import go "io"
import go "encoding"
import go "fmt"

// @method may return `Result T GoError`: the emitted Go method
// unwraps it to (T, error) — io.Writer's `Write([]byte) (int,
// error)` — and `Result Unit GoError` unwraps to a bare `error`
// (encoding.TextUnmarshaler).
type Counter = { n: Int }

@method
fn (c: Counter) write (p: List Byte) -> Result Int GoError = Ok c.n

type U = { v: Int }

@method
fn (u: U) unmarshal_text (p: List Byte) -> Result Unit GoError = Ok ()

fn main () -> Unit = {
  let c = { n = 3 }
  let w : io.Writer = c
  ignore (fmt.Println w)
}
