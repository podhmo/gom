package ex

import go "os"

fn band (x: Int) (y: Int) -> Int = x &&& y
fn bor (x: Int) (y: Int) -> Int = x ||| y
fn bxor (x: Int) (y: Int) -> Int = x ^^^ y
fn bclear (x: Int) (y: Int) -> Int = x &&^ y
fn shl (x: Int) (n: Int) -> Int = x <<< n
fn shr (x: Int) (n: Int) -> Int = x >>> n

// ||| and ^^^ sit at the add level, &&&/&&^/<<</>>> at the mul
// level — `a ||| b &&& c` is `a ||| (b &&& c)`.
fn flags (a: Int) (b: Int) -> Int = a ||| b &&& 255

// Underlying-integral named Go types are admissible, like %.
fn mode_bits (m: os.FileMode) -> os.FileMode = m &&& (Go.conv 511 : os.FileMode)

fn main () -> Int =
  band 6 3 + bor 4 1 + bxor 5 3 + bclear 7 3 + shl 1 4 + shr 64 4 + flags 5 300
