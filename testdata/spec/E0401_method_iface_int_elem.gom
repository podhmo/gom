package main

// A nested raw int element (`Take(xs []int)`) is inexpressible:
// container elements emit through goType where both Int and Int64
// spell int64, never int. Such a method is not even exposed — the
// gom/raw views diverge inside the container and no element-wise
// boundary conversion exists — so conformance fails with E0401
// rather than passing a method set the generated Go does not carry.
import go "github.com/podhmo/gom/testdata/goiface"

type W = { n: Int }

@method
fn (w: W) take (xs: List Int) -> Int = 0

fn main () -> Unit = {
  let w = { n = 0 }
  let x : goiface.WidthIntElem = w
  ignore x
  ()
}
