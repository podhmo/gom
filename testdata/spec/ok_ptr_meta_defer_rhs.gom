package ex

import go "github.com/podhmo/gom/testdata/goiface"

// A deferred RHS pins its own receiver: `readN b` constrains `b`
// to `Ptr SliceBox`, so `.N` resolves on the next member retry
// rather than after the last one.
fn readN (b: Ptr goiface.SliceBox) -> Int = b.N

fn pinned () -> Int = {
  let b = Ptr.new ()
  b.N = readN b
  b.N
}

// Literals minted by a deferred RHS's check take a default pass of
// their own — `ignore 1` keeps its Int, not an unsolved E0407.
fn blocky () -> Ptr goiface.SliceBox = {
  let b = Ptr.new ()
  b.N = { ignore 1; 7 }
  b
}

// The deferred RHS keeps the enclosing boundary: `try` inside it
// still escapes to this Result-returning fn.
fn mk () -> Result Int GoError = Ok 1

fn tried () -> Result (Ptr goiface.SliceBox) GoError = {
  let w = Ptr.new ()
  w.N = try (mk ())
  Ok w
}

// The RHS both pins `?m` and carries a lambda needing the field's
// `Go.FuncN` signature — the provisional nil-want fill's
// diagnostics must not survive the real re-check.
fn calln (w: Ptr goiface.WithFn) -> Int = w.Call ()

fn callback () -> Ptr goiface.WithFn = {
  let w = Ptr.new ()
  w.Fn = Go.func1 (fn x -> x + calln w)
  w
}

// `w.Call ()` is a Go method call on a receiver the field write's
// RHS pins — the deferred apply must wait for that resolution
// instead of committing as a curried Gom call early.
fn pass (w: Ptr goiface.WithFn) -> Go.Func1 Int Int = w.Fn

fn pinvia () -> Int = {
  let w = Ptr.new ()
  w.Call ()
  w.Fn = pass w
  w.Call ()
}
