package main

type Payload = { value: String }
type OtherPayload = { value: String }
type Box a = { value: a }
type Pair a b = { fst: List a, snd: b }

fn consume (x: Pair a (Box a)) -> Unit = ()

// The nested `Box` argument determines the shared payload type before
// the bare list argument checks its ambiguous record element.
fn nested_shared () -> Unit =
  consume (Pair { snd = Box { value = Payload { value = "y" } }, fst = [{ value = "x" }] })
