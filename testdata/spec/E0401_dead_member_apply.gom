package ex

// An application deferred on a member that fails to resolve is
// dead work: the member's E0401 is the only diagnostic — the
// metas the dropped call minted (its standing result, the `[]`
// argument's element meta) are quieted at drop time, so no E0407
// piles on. The receiver is a lambda parameter's meta so the
// selection genuinely defers until the argument `0` settles it.

fn main () -> Unit = {
  (fn x -> x.Nope []) 0
  ()
}
