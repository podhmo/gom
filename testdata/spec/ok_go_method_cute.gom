package ex

import go "fmt"
import go "strings"
import go "time"

// Go method calls (spec 8.1.3) take the tuple convention like a Go
// function call, and a `_` among the arguments is the cute
// placeholder of spec 8.2: `t.AddDate(_, 2, 3)` is a one-argument
// function capturing 2 and 3 at creation. When the receiver's type
// is not yet known — an unannotated lambda parameter — the calling
// convention settles once the receiver binds (the deferred member
// application), so `fn x -> x.AddDate(_, 2, 3)` is the same partial
// call once `x` turns out to be a time.Time.
fn show (t: time.Time) -> String = t.Format "2006-01-02"

fn main () -> Unit = {
  let t0 = time.Unix(0, 0)
  let direct = t0.AddDate(5, 2, 3)
  let later = fn x -> x.AddDate(_, 2, 3)
  let delayed = later t0 5
  let r = strings.NewReader "hi"
  let _ = fmt.Println("${show direct} ${show delayed} ${r.Len ()}")
  ()
}
