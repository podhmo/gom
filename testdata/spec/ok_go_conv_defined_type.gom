package main

import go "encoding/json"
import go "time"

// A one-field record emits as the Go defined type `type X F`, so
// `Go.conv` accepts the pairs whose `T(x)`/`X(f)` emission stays
// legal for a named operand (spec 8.4): identical-underlying pairs
// and pairs where both underlyings are numeric basic kinds —
// `litRange`'s oracle view covers named Go underlyings like
// `time.Duration`. The peel chases chains (`M`'s field is itself a
// defined type).
type UserId = { value : Int }
type U32 = { v : Int32 }
type M = { u : UserId }
type D = { d : time.Duration }
type Xs = { xs : List Int }
type Text = { t : String }
type C = { c : Chan Int }

fn main () -> Unit = {
  let u = { value = 7 }
  let n : Int = Go.conv u : Int
  let u2 : UserId = Go.conv n : UserId
  let i64 : Int64 = Go.conv u : Int64
  let f : Float = Go.conv u : Float
  let w : U32 = Go.conv u : U32
  let m = { u = u2 }
  let n2 : Int = Go.conv m : Int
  let d = { d = Go.conv 5 : time.Duration }
  let dn : Int = Go.conv d : Int
  let dd : time.Duration = Go.conv d : time.Duration
  ignore (n + n2 + dn)
  ignore i64
  ignore f
  ignore w
  ignore dd
  ()
}

// `Xs`'s field is the builtin `List` — an immutable view, so the
// equal-underlying `Xs(l)` cast shares backing safely. (The
// opposite direction — into `Go.Slice` — would need the boundary
// copy and stays E0507; see E0507_go_conv_defined_reject.)
fn pack (l : List Int) -> Xs = Go.conv l : Xs
fn unpack (x : Xs) -> List Int = Go.conv x : List Int

// Identical-underlying pairs beyond builtins: `json.Number` is
// `type Number string`, so both `json.Number(t)` and `string(n)`
// compile — the oracle's mutual convertibility is what admits them.
fn num (t : Text) -> json.Number = Go.conv t : json.Number
fn text (n : json.Number) -> Text = Go.conv n : Text

// The restrictive channel targets emit as the unnamed `chan<- T` /
// `<-chan T` — Go admits a named bidirectional source there.
fn sendc (c : C) -> SendChan Int = Go.conv c : SendChan Int
fn recvc (c : C) -> RecvChan Int = Go.conv c : RecvChan Int
type S = { s : SendChan Int }
type P = { p : Ptr Int }

// The inverse direction is legal too: the unnamed `chan int64`
// source satisfies Go's one-side-unnamed rule, so `S(ch)` is a
// valid narrowing to the named send-only wrapper.
fn wrap_send (ch : Chan Int) -> S = Go.conv ch : S

// `Ptr Int` and `Ptr Int64` render the same `*int64` — a peeled
// defined type converts to it through the identical-underlying
// rule even though the element spellings differ.
fn widen_ok (p : P) -> Ptr Int64 = Go.conv p : Ptr Int64
fn wrap_ptr (p : Ptr Int) -> P = Go.conv p : P
