package main

import go "github.com/podhmo/gom/testdata/goiface"

// Arm 1 is checked while the scrutinee meta is still open — its
// body then binds it to S, so the literal judges at float32 width
// only after re-judging: 16777217.0 and 16777216.0 are the same
// float32, and the record arm below duplicates the literal arm.
type S = { v: goiface.SmallRatio }

let pick = fn x ->
  match x {
    16777217.0 -> { let y : S = x; 1 }
    { v = 16777216.0 } -> 2
    _ -> 3
  }
