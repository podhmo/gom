package main

// `type alias X = T` names an existing type without introducing a
// new one (spec 3.2) — the alias expands to T at every position, so
// values pass between the alias and the underlying type freely.
type alias UserId = Int
type alias Wrap a = List a
type alias Id = UserId

fn takes (id: UserId) -> Int = id
fn wrap (xs: Wrap Int) -> Int = List.length xs

let n : Int = 7
let u : UserId = n
let back : Int = u
let ws : Wrap Int = [1, 2]
let m : Id = u

// A forward reference to a later alias expands through it (the
// registration pass marks alias decls before bodies resolve), and a
// generic alias forwards its parameters.
type alias Fwd = UserId2
type alias UserId2 = Int
type alias W a = Wrap2 a
type alias Wrap2 a = List a

fn fw (x: Fwd) -> Int = x
fn wg (xs: W Int) -> Int = List.length xs
