package main

// The tuple payload of a fallible return spreads positionally:
// `Result (Int64, Int) GoError` against `(int64, int64, error)`
// mismatches the second element's width — the root spelling of Int
// is int, not the required int64 — so conformance fails.
import go "github.com/podhmo/gom/testdata/goiface"

type W = { n: Int }

@method
fn (w: W) pair () -> Result (Int64, Int) GoError = Ok (0, 0)

fn main () -> Unit = {
  let w = { n = 0 }
  let x : goiface.WidthPair = w
  ignore x
  ()
}
