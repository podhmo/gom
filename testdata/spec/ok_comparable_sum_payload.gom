package ex

import go "slices"
import "github.com/podhmo/gom/testdata/spec/foreignpkg"

// A sum whose every variant payload is comparable stays admitted:
// the sealed-interface repr's `==` never reaches a non-comparable
// dynamic value. `Option Shape` likewise — its box's element is
// comparable. Recursion is coinductive: `Tree`'s Node fields spell
// the same sealed interface being judged, so they answer "as
// comparable as Tree itself" and the Int payload decides. `Task`
// compares its channel/pointer handle, never the payload. Imported
// declarations fold the same way — foreignpkg.Shape's fields are
// loaded through the import (spec 8.5).
type Shape = | Circle (r: Float) | Empty
type Tree = | Leaf (v: Int) | Node (l: Tree) (r: Tree)
type TreeT a = | LeafT (v: a) | NodeT (l: TreeT a) (r: TreeT a)
type Job = | Run (t: Task (List Int))
type Wrap = | Box (s: foreignpkg.Shape)

fn has (xs: Go.Slice Shape) (needle: Shape) -> Bool =
    slices.Contains(xs, needle)

fn has_some (xs: Go.Slice (Option Shape)) (needle: Option Shape) -> Bool =
    slices.Contains(xs, needle)

fn has_tree (xs: Go.Slice Tree) (needle: Tree) -> Bool =
    slices.Contains(xs, needle)

// `TreeT Int` reaches its `TreeT a` children with `a` still bound
// to `Int` — a generic recursion keeps the caller's instantiation.
fn has_treet (xs: Go.Slice (TreeT Int)) (needle: TreeT Int) -> Bool =
    slices.Contains(xs, needle)

fn has_job (xs: Go.Slice Job) (needle: Job) -> Bool =
    slices.Contains(xs, needle)

fn has_foreign (xs: Go.Slice foreignpkg.Shape) (needle: foreignpkg.Shape) -> Bool =
    slices.Contains(xs, needle)

fn has_wrap (xs: Go.Slice Wrap) (needle: Wrap) -> Bool =
    slices.Contains(xs, needle)
