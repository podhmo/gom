package ex

import go "fmt"
import go "os"
import go "strings"

// The ordinary `[]T` boundary copies in both directions (spec 8.5):
// the `os.Args` var arrives through `list.FromSlice`, a `List`
// argument leaves through `.ToSlice()`, and the `..args` spread on
// `...any` boxes each element (`rt.BoxSlice`).
fn main () -> Unit = {
  let args = os.Args
  let _ = strings.Join(args, " ")
  let _ = fmt.Println(..args)
  let env = os.Environ ()
  let _ = env
  ()
}
