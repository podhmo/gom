package main

import go "time"
import go "github.com/podhmo/gom/testdata/goiface"

// Named Go integer types participate in arithmetic and comparison
// by Go's own rules (decision 2026-11-17-named-int-arith):
// `30 * time.Second` is a Duration — the untyped literal conforms
// to the operand's named type — and named x named operands return
// the named type, no `Go.conv` needed.
fn half_min () -> time.Duration = 30 * time.Second

fn per_hour () -> time.Duration = 2 * time.Hour

fn add (a: time.Duration) (b: time.Duration) -> time.Duration = a + b

fn left (deadline: time.Duration) (now: time.Duration) -> time.Duration = deadline - now

fn resto (a: time.Duration) (b: time.Duration) -> time.Duration = a % b

fn maior (a: time.Duration) (b: time.Duration) -> Bool = a > b

fn lit_named (d: time.Duration) -> time.Duration = d + 5

// Literal-only expressions under a named binder materialize the
// named type per literal — `1 + 2` stays a Ticks (not Go's default
// `int`), and `1 / 2` under a Ratio binder is `0.5` (not the
// integer `0` a bare constant would fold to).
fn ticks () -> goiface.Ticks = 1 + 2

fn ticks_let () -> goiface.Ticks = {
  let t : goiface.Ticks = 3 * 4
  t
}

fn ratio () -> goiface.Ratio = 1 / 2

fn ratio_let () -> goiface.Ratio = {
  let r : goiface.Ratio = 1 / 2
  r + 0.25
}

// `-min` keeps the sign inside the conversion — a bare
// `-Ticks(9223372036854775808)` would overflow the magnitude before
// negating.
fn neg_min () -> goiface.Ticks = -9223372036854775808

// A discarded literal at a named type still needs `_ =` — a bare
// `Ticks(1)` statement is "not used" in Go (conversions are not
// calls in statement position).
fn discard_named () -> Int = {
  let _ : goiface.Ticks = 1
  0
}
