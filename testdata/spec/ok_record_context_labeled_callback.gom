package main

type Acc = { count: Int }
type Other = { count: Int }

fn apply_labeled (f: ~acc: a -> a) (seed: a) -> a = f ~acc: seed

fn positional_labeled () -> Acc =
  apply_labeled (fn acc -> { acc with count = acc.count + 1 }) { count = 0 }

fn labeled_labeled () -> Acc =
  apply_labeled (fn ~acc -> { acc with count = acc.count + 1 }) { count = 0 }

fn apply_nested (f: ~step: Int -> ~acc: a -> a) (seed: a) -> a = f ~step: 1 ~acc: seed

fn positional_nested () -> Acc =
  apply_nested (fn step -> fn acc -> { acc with count = acc.count + step }) { count = 0 }
