package m

// A `/*` inside a quoted string opens no block comment — the
// directive below still applies.
let fake = "an unclosed /* quote"
let interp = "nested ${ "`raw /*`" } tail"

//gom:allow W0901

fn add (a: Int) -> Int -> Int = fn b -> a + b

fn dropper () -> Unit = {
  ignore (add 1)
  let _ = add 2
}
