// A bare iterable shared as a member call's receiver: `for v in
// x` defers `?x`, and `x.fold ~f: ... ~acc: 0 x` waits on the same
// meta. The `List` default must land before the deferred call
// commits — otherwise the call replays against the committed
// `Unit -> ?r` fallback and rejects `~f:` as a spurious
// labeled-argument error instead of reporting that List has no
// `fold`.

package main

fn f () -> Int = {
  let g = fn x -> {
    for v in x {
      ignore v
    }
    x.fold ~f: (fn acc v -> acc + v) ~acc: 0 x
  }
  g [1, 2]
}
