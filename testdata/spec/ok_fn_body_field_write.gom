package ex

import go "errors"
import go "github.com/podhmo/gom/testdata/goiface"

// An annotated `let`'s `fn` body propagates the expected type into
// field writes: the unannotated parameter `w` binds `Ptr WithFn`
// from the outer annotation, the deferred member resolves at
// revisit, and the `Go.funcN` RHS checks under the field's
// `Go.FuncN` signature — no inner annotations needed (the
// implementation-gaps "fn 本体の期待型伝播" case).
let initw : Ptr goiface.WithFn -> Unit = fn w -> {
  w.Fn = Go.func1 (fn x -> x + 1)
  ()
}

// The same under the `tap` initialization idiom:
// `Ptr.new () |> tap initw`.
let tap : (a -> Unit) -> a -> a = fn f x -> {
  f x
  x
}

fn make () -> Ptr goiface.WithFn = Ptr.new () |> tap initw

// The wave25 redirect-callback shape: two parameters the body never
// uses, and an `Err` result whose success side only the field's
// `func(int64, string) error` signature can supply — the want must
// reach `Go.func2`'s lambda for `_n`, `_s`, and `Err` to type.
let initerr : Ptr goiface.WithFn -> Unit = fn w -> {
  w.Guard = Go.func2 (fn _n _s -> Err (errors.New "stop"))
  ()
}
