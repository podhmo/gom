package main

// If-arm joining under a bare `Go.Any` want is source-order
// dependent: the `1` arm settles the join meta to a numeric type
// before `v`'s `any` reaches it, and a settled numeric cannot
// reopen into `any`. The reversed order (`v` first, then `1`)
// conforms — the concrete arm boxes into the settled `any` slot —
// so write the `any`-typed arm first today. Ordering-independence
// would need a two-pass join; pinned as-is here.
fn p (v: Go.Any) -> Go.Any = if true { 1 } else { v }
fn main () -> Unit = ()
