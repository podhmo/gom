package main

import go "fmt"

// A Gom record type conforms to a Go interface when its @method
// set covers the interface's methods with matching signatures.
type Greeter = { name: String }

type Failure = { reason: String }

// The conformance holds even when the @method decl sits later in
// the file than the assignment.
fn main () -> Unit = {
  let g = { name = "x" }
  let st : fmt.Stringer = g
  let f = { reason = "y" }
  let e : GoError = f
  ignore (fmt.Println st)
  ignore (fmt.Println e)
}

@method
fn (g: Greeter) string () -> String = g.name

@method
fn (f: Failure) error () -> String = f.reason

// A Ptr receiver method exists on the pointer only — the record
// value does not gain it for interface conformance.
type Box = { v: Int }

@method
fn (b: Ptr Box) describe () -> String = "boxed"
