package main

import go "github.com/podhmo/gom/testdata/goiface"

// func-typed extern parameters are supported via `Go.FuncN`, so the
// member's Gom type is `Go.Func1 Go.Any Int` — declaring the raw
// arrow `Go.Any -> Int` mismatches it (E0509).
extern go "github.com/podhmo/gom/testdata/goiface" {
  fn TakesAnyFn (f: Go.Any -> Int) -> Int
}

fn main () -> Unit = ignore 1
