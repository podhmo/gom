package ex

import go "errors"

// An application of a hidden Go callee reports E0506 alone —
// `errors.AsType`'s E parameter carries `error`, a method-set
// constraint outside the admitted set (spec 8.5), so the symbol
// stays unexposed; no arity mismatch (E0401) can fire on top of it.
fn f (e: Go.Any) -> Bool =
  errors.AsType(e)
