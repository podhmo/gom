package ex

import go "github.com/podhmo/gom/testdata/goiface"

// A builtin name the file redeclares spells the local type, not the
// builtin: `type W Int` underlies a struct here, so the union-term
// peel must not hand `Int` to the boundary oracle (which cannot see
// the shadow and would read `int64`). `~int64` rejects `W` — the
// emitted `Clamp64[W]` would fail `go build` otherwise (spec 8.5).
type Int = { x : Bool, y : Bool }
type W = { f : Int }

fn f (w: W) -> W = goiface.Clamp64 w w w
