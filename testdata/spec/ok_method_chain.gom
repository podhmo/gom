package main

import go "fmt"
import go "time"

// A selector following a parenthesized argument list continues the
// application — `t.AddDate(1, 0, 0).AddDate(0, 1, 0)` chains the
// second call on the first's result the way Go does
// (spec 8.1.3, decisions/2026-11-05-post-arg-selector-binding). The
// explicitly parenthesized `(t.AddDate(1, 0, 0)).AddDate(0, 1, 0)`
// reads identically.
fn main () -> Unit = {
  let t0 = time.Unix(0, 0)
  let chained = t0.AddDate(1, 0, 0).AddDate(0, 1, 0)
  let explicit = (t0.AddDate(1, 0, 0)).AddDate(0, 1, 0)
  let _ = fmt.Println("${chained.Format "2006-01-02"} ${explicit.Format "2006-01-02"}")
  ()
}
