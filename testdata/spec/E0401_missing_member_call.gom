package ex

// A var-bound call of a member that fails to resolve defers like
// the member call itself: `f` aliases `x.M`, so `f (fn y -> y)`
// waits in pendingApplies — when `.M` fails, the drop quiets metas
// minted inside the dead call (the lambda's shared return type) and
// reports the E0401 alone instead of a bogus annotation request.
fn f () -> Unit = {
  (fn x -> {
    let f = x.M
    f (fn y -> y)
    ()
  }) 0
}

// The quiet is scoped to metas minted inside the dead call: `g`'s
// lambda type is shared from outside, so its own "annotation
// required" (E0407) must still report — only the member's E0401
// and `g`'s own undetermined type appear.
fn g () -> Unit = {
  (fn x -> {
    let f = x.M
    let g = (fn y -> y)
    f g
    ()
  }) 0
}
