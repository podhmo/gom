package main

/// docs for Color
type Color =
  | Red
  /// docs for Rgb
  | Rgb Int Int Int

extern go "bytes" {
  fn NewBufferString (s: String) -> Buffer
  /// comment on second entry
  fn Len (b: Buffer) -> Int
}

@test
fn helper () -> Int = 1

test "smoke" { let x = 1 }

@tailrec
fn loop (n: Int) (acc: Int) -> Int = if n <= 0 { acc } else { loop (n - 1) (acc + n) }
