// wave23 lane4 — cons-recursion 特殊化が救えない蓄積形の実測 fixture.
// 生成される Go（`gom build` の a.go 相当: noncons.go）を bench_test.go
// が計測する。shape ごとの説明は各 fn のコメントと sketch
// docs/sketch/2026-11-19-wave23-noncons-accum.md を見る。
package noncons

// 比較基準: match-cons 自己再帰 — cons-recursion 特殊化で buffer loop
// 化される被覆形（decision 2026-11-18-cons-recursion-specialization）。
fn cons_map (xs: List Int) -> List Int = match xs {
  [] -> []
  [h, ..t] -> [h + 1, ..cons_map t]
}

// (i) 連鎖 append: 蓄積済みの結果を append の左辺に置く — `List.append`
// は buffer loop 化済みでも左辺コピーは O(len acc) で、レベルごとに
// acc が育つので全体 O(k²·chunk)。
fn chain_append (k: Int) -> List Int = if k == 0 {
  []
} else {
  List.append (chain_append (k - 1)) (List.range (k * 8) (k * 8 + 8))
}

// (ii) fold 内 concat: ユーザーが書く folder が append で acc を積む
// 形。特殊化は match-cons 自己再帰しか見ないので対象外。
fn fold_concat (xs: List Int) -> List Int =
  List.fold (fn acc x -> List.append acc [x * 2]) [] xs

// (iii) 相互再帰の蓄積: Callee == 自分 の要件を外れる — mut_a の
// cons 呼び出しは mut_b 宛、mut_b は素の委譲。
fn mut_a (n: Int) -> List Int = if n == 0 {
  []
} else {
  [n, ..mut_b (n - 1)]
}

fn mut_b (n: Int) -> List Int = mut_a n

// (iv) 呼び出し結果の 2 度読み: `rest` を head と ..rest の両方で
// 読むため要件 4 で除外される形。
fn read_twice (xs: List Int) -> List Int = match xs {
  [] -> []
  [h, ..t] -> {
    let rest = read_twice t
    [List.length rest + h, ..rest]
  }
}

// (v) 線形ラッパは誤検出しない: mut_a を1回呼ぶだけ — コストは結果の
// 一回コピーで O(n)。警告は mut_a 自身の箇所に出る。
fn wrap_once (n: Int) -> List Int = [0, ..mut_a n]

// (vi) concat 直掛け: 再帰結果を要素に持つ list-of-lists を concat —
// 各レベルで蓄積分を flatten し直すので O(n²)。
fn concat_acc (n: Int) -> List (List Int) = if n == 0 {
  [[]]
} else {
  List.concat [concat_acc (n - 1), [[n]]]
}

// (vii) 名前付き folder: fold に渡す folder がファイル内の名前付き
// fn でも検出する。
fn appender (acc: List Int) (x: Int) -> List Int = List.append acc [x]

fn fold_named (xs: List Int) -> List Int = List.fold appender [] xs

// (viii) 同一関数内の複数箇所: let ごとに別 site として警告する。
fn two_sites (n: Int) -> List Int = if n == 0 {
  []
} else {
  let a = List.append (two_sites (n - 1)) [n]
  List.append (two_sites (n - 1)) [List.length a]
}

// (ix) 誤検出しない: 再帰呼び出しの「スカラー」結果を 1 要素リテラル
// に入れて append する形は O(1)/step（list-of-lists ではない）。
fn lit_scalar_a (n: Int) -> List Int = if n == 0 {
  []
} else {
  List.append [lit_scalar_b (n - 1)] [0]
}

fn lit_scalar_b (n: Int) -> Int = if n == 0 {
  0
} else {
  List.length (lit_scalar_a (n - 1))
}
