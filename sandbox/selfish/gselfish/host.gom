// @extern declarations whose bodies live in host.go — the parts of
// the port gom can't express:
//
//   - http.RoundTripper (@method can't return Result, E0420), so the
//     fake client is a handwritten Go func.
//   - github.GistsService.{Create,Edit} return 3 values (E0501), so
//     they get (*Gist, error) wrappers.
//   - github.GistFile.Size is *int — gom has no `int` (Ptr Int is
//     *int64) — so the literal is built Go-side.
package main

import go "context"
import go "net/http"
import go "github.com/google/go-github/v68/github"

@extern fn fake_http_client () -> Ptr http.Client

@extern fn gists_create (c: Ptr github.Client) (ctx: context.Context) (gist: Ptr github.Gist) -> Result (Ptr github.Gist) GoError

@extern fn gists_edit (c: Ptr github.Client) (ctx: context.Context) (gist_id: String) (gist: Ptr github.Gist) -> Result (Ptr github.Gist) GoError

@extern fn host_new_gist_file (filename: String) (size: Int) (content: String) -> Ptr github.GistFile

// errors.Wrap(err, msg): %s: %w keeps the Unwrap chain; @extern
// because a generated fmt.Errorf call boxes the error into `any`,
// which go vet rejects for %w.
@extern fn wrap (e: GoError) (msg: String) -> GoError

// errors.Wrapf(err, format, arg) — same %w constraint; the format
// stays a runtime string so vet leaves it alone.
@extern fn wrapf (e: GoError) (format: String) (arg: Go.Any) -> GoError
