// Port of internal/model.go.
package main

import go "fmt"
import go "log"
import go "os"
import go "path"
import go "path/filepath"
import go "strings"
import go "github.com/google/go-github/v68/github"
import commithistory "github.com/podhmo/selfish/gomcommithistory"

// internal.Commit = commithistory.Commit
type alias Commit = commithistory.Commit

// Fold accumulator for new_gist.
type GistAcc = { title: Option String, files: Go.Map github.GistFilename github.GistFile }

// NewGist is shorthand of github.Gist object creation. The title is
// the first `# ` heading of a file literally named readme.md.
fn new_gist (filenames: List String) (public: Bool) -> Result (Ptr github.Gist) GoError = {
  let collect = fn (acc: GistAcc) (filename: String) -> match new_gist_file filename {
    Err e -> { ignore (log.Printf ("skip file=%s err=%v\n", filename, e)); acc }
    Ok gistfile -> {
      let title =
        if strings.ToLower (filepath.Base filename) == "readme.md" {
          Ptr.to_option gistfile.Content
            |> Option.and_then (fn c -> readme_title (strings.TrimLeft (c, "\n\t ")))
            |> Option.or_else acc.title
        } else { acc.title }
      Go.Map.set acc.files (Go.conv (filepath.Base filename) : github.GistFilename) (Ptr.get gistfile)
      { acc with title = title }
    }
  }
  let empty : Go.Map github.GistFilename github.GistFile = Go.Map.make ()
  let acc : GistAcc = List.fold collect { title = None, files = empty } filenames
  let gist : Ptr github.Gist = Ptr.new ()
  gist.Public = Ptr.make public
  gist.Files = acc.files
  gist.Description = Ptr.make (Option.get_or_else "" acc.title)
  Ok gist
}

// The first `# ` heading, trimmed; readme.md only (caller checks).
fn readme_title (text: String) -> Option String = first_heading (strings.Split (text, "\n"))

@tailrec fn first_heading (lines: List String) -> Option String = match lines {
  [] -> None
  [line, ..rest] -> match strings.CutPrefix (line, "# ") {
    (after, true) -> Some (strings.TrimSpace after)
    (_after, false) -> first_heading rest
  }
}

// NewGistFile is shorthand of github.GistFile object creation.
fn new_gist_file (filename: String) -> Result (Ptr github.GistFile) GoError = {
  let basename = path.Base filename
  let finfo = Option.get (try (wrap_result (os.Stat filename) "stat"))
  let size = finfo.Size ()
  if size == 0 {
    try Err (fmt.Errorf "empty file")
  }
  let byte = try (wrap_result (os.ReadFile filename) "read all")
  let content = Go.conv byte : String
  // *int can't be spelled in gom (Ptr Int is *int64), so the
  // GistFile literal lives in host.go.
  Ok (host_new_gist_file basename size content)
}
