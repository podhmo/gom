// Port of internal/client.go.
package main

import go "context"
import go "fmt"
import go "log"
import go "time"
import go "github.com/google/go-github/v68/github"

type Client = { github: Ptr github.Client }

type CreateResult = {
  gist_id: String `json:"GistID"`,
  created_at: time.Time `json:"CreatedAt"`,
  html_url: String `json:"HTMLURL"`,
  raw: Ptr github.Gist `json:"-"`,
}

// zero_time is Go's time.Time{} (via new(T) + deref).
fn zero_time () -> time.Time = Ptr.get (Ptr.new ())

// Go pointer-field conveniences: *string -> String, *Timestamp -> Time.
fn ptr_str (p: Ptr String) -> String = Option.get_or_else "" (Ptr.to_option p)

fn ptr_timestamp (p: Ptr github.Timestamp) -> time.Time =
  Option.get_or_else (zero_time ()) (Option.map (fn ts -> ts.Time) (Ptr.to_option p))

fn client_create (c: Client) (ctx: context.Context) (filenames: List String) (public: Bool) -> Result CreateResult GoError = {
  let gist = try (Result.map_err
    (fn e -> wrapf e "invalid file name is found. %q" filenames)
    (new_gist filenames public))
  let (g0, _resp) = try (c.github.Gists.Create ctx gist)
  let g = match Ptr.to_option g0 {
    Some g -> g
    None -> try Err (fmt.Errorf "gist api create returned nil gist")
  }
  let html_url = ptr_str g.HTMLURL
  let created_at = ptr_timestamp g.CreatedAt
  let gist_id = ptr_str g.ID
  let r : CreateResult = { gist_id = gist_id, created_at = created_at, html_url = html_url, raw = g0 }
  Ok r
}

type UpdateResult = {
  gist_id: String `json:"GistID"`,
  created_at: time.Time `json:"CreatedAt"`,
  html_url: String `json:"HTMLURL"`,
  raw: Ptr github.Gist `json:"-"`,
}

fn client_update (c: Client) (ctx: context.Context) (gist_id: String) (filenames: List String) (public: Bool) -> Result UpdateResult GoError = {
  let gist = try (Result.map_err
    (fn e -> wrapf e "invalid file name is found. %q" filenames)
    (new_gist filenames public))
  let (g0, _resp) = try (c.github.Gists.Edit ctx gist_id gist)
  let g = match Ptr.to_option g0 {
    Some g -> g
    None -> try Err (fmt.Errorf "gist api edit returned nil gist")
  }
  let html_url = ptr_str g.HTMLURL
  let created_at = ptr_timestamp g.CreatedAt
  match Ptr.to_option g.ID {
    Some id -> if id != gist_id {
      ignore (log.Printf ("WARN: gistId is mismatch %q != %q", gist_id, id))
    }
    None -> ()
  }
  let r : UpdateResult = { gist_id = gist_id, created_at = created_at, html_url = html_url, raw = g0 }
  Ok r
}

fn client_delete (c: Client) (ctx: context.Context) (gist_id: String) -> Result Unit GoError =
  c.github.Gists.Delete (ctx, gist_id) |?> fn _response -> Ok ()
