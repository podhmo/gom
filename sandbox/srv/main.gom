// srv — 最小 HTTP サーバ。Go の http.HandlerFunc 境界を試す。
//   srv [ADDR]    デフォルト :18081
//   GET /         -> "hello from gom"
//   GET /echo     -> ?q= をそのまま返す
package main

import go "fmt"
import go "net/http"
import go "os"
import go "time"

fn handler (w: http.ResponseWriter) (r: Ptr http.Request) -> Unit = {
  let q = (r.URL.Query ()).Get "q"
  ignore fmt.Fprintf (w, "method=%s path=%s q=%s\n", r.Method, r.URL.Path, q)
  ()
}

fn program_args () -> List String = match Go.Slice.to_list os.Args {
  [] -> []
  [_, ..args] -> args
}

fn main () -> Unit = {
  let addr = match program_args () {
    [] -> ":18081"
    [a, .._] -> a
  }
  let mux = http.NewServeMux ()
  mux.HandleFunc ("/", Go.func2 handler)
  mux.HandleFunc ("/echo", Go.func2 handler)
  // ヘッダ読み込みにデッドラインがないとコネクションを握ったまま
  // リクエストを完了させないクライアントで枯渇するので明示する。
  let srv : Ptr http.Server = Ptr.new ()
  srv.Addr = addr
  srv.Handler = mux
  srv.ReadHeaderTimeout = (Go.conv 5 : time.Duration) * time.Second
  srv.ReadTimeout = (Go.conv 10 : time.Duration) * time.Second
  srv.WriteTimeout = (Go.conv 10 : time.Duration) * time.Second
  srv.IdleTimeout = (Go.conv 60 : time.Duration) * time.Second
  ignore fmt.Fprintln (os.Stderr, "listening on ${addr}")
  match srv.ListenAndServe () {
    Ok _ -> ()
    Err e -> { ignore fmt.Fprintln (os.Stderr, "srv: ${e.Error ()}"); ignore os.Exit 1; () }
  }
}
